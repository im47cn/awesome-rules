{"type":"session","version":3,"id":"01a0343c-f52b-75c6-b9e2-c67624ccad05","timestamp":"2026-08-24T14:46:45.291Z","cwd":"/var/folders/zn/w06grcb53sl3spdn751tgsx80000gn/T/tmpbv2mq025"}
