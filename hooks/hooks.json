{
  "description": "SessionStart 注入 steering 规范索引，使 AI 在相关任务时主动加载对应规范文件",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/load-steering.sh\""
          }
        ]
      }
    ]
  }
}
