  "cards": [
    {
      "dot": "cyan",
      "title": "完整档六模块",
      "items": [
        "每业务域 6 个 Maven 模块，pom 编译期强制依赖矩阵",
        "start 仅启动装配不含业务；client 可单独发布 JAR",
        "全员继承 gtsp-parent，公共依赖版本父 POM 统一"
      ]
    },
    {
      "dot": "emerald",
      "title": "依赖纪律",
      "items": [
        "依赖方向 adapter → app → domain ← infrastructure，禁止反向",
        "domain 不依赖 Spring Boot Starter / MyBatis（JPA 标注豁免）",
        "写操作禁止绕过 Domain 直调 Mapper；值对象不可变"
      ]
    },
    {
      "dot": "violet",
      "title": "跨域解耦",
      "items": [
        "禁止跨业务域直接 Maven 依赖，仅三种通信方式",
        "client Inter 同步 · 领域事件异步（MQ）· 复制值对象零耦合",
        "CQRS：读可绕 Domain 直连 Mapper，事务边界仍在 AppService"
      ]
    }
  ]
