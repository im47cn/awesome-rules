def test_extra_fields_do_not_satisfy_required_ones():
    # 仅有 description 而无 title:无关字段不能顶替必填字段
    text = "---\ndescription: 某描述\nscenario: s\n---\n"
    assert cff.missing_fields(text) == ["title"]
```

