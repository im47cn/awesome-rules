#!/usr/bin/env bash
# 变更行覆盖率红线 — pre-commit 轻量检查
# 只复用已有 coverage 产物 (不跑测试, 全量兜底在 pre-push); 产物/工具缺失则跳过不阻断。
set -u
FAIL_UNDER=95

# 链式执行仓库自有 .git/hooks/<同名钩子> (hooksPath 会旁路它们); 失败则短路退出
legacy="$(git rev-parse --git-dir)/hooks/$(basename "$0")"
if [ -x "$legacy" ]; then
  "$legacy" "$@" || exit $?
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
echo "$staged" | grep -qE '\.py$'       && HAS_PY=1 || HAS_PY=0
echo "$staged" | grep -qE '\.(ts|tsx)$' && HAS_TS=1 || HAS_TS=0
[ $((HAS_PY + HAS_TS)) -eq 0 ] && exit 0

# diff-cover 入口: PATH → 当前 python 环境 → uv 按需拉取; 均无则提示后放行
dc() {
  if command -v diff-cover >/dev/null 2>&1; then diff-cover "$@"
  elif python3 -c 'import diff_cover' >/dev/null 2>&1; then python3 -m diff_cover.diff_cover_tool "$@"
  elif command -v uv >/dev/null 2>&1; then uv tool run diff-cover "$@"
  else echo "[cov-hook] diff-cover 不可用, 跳过 (安装: pip install diff-cover / uv add diff-cover)"; return 0
  fi
}

fail=0
if [ "$HAS_PY" = 1 ]; then
  for d in . backend; do
    [ -f "$d/coverage.xml" ] || continue
    echo "[cov-hook] pre-commit $d python staged 变更覆盖检查 (≥${FAIL_UNDER}%)"
    (cd "$d" && dc coverage.xml --compare-branch=HEAD --ignore-unstaged --fail-under="$FAIL_UNDER") || fail=1
  done
fi
if [ "$HAS_TS" = 1 ]; then
  for d in . frontend; do
    [ -f "$d/coverage/lcov.info" ] || continue
    echo "[cov-hook] pre-commit $d ts staged 变更覆盖检查 (≥${FAIL_UNDER}%)"
    (cd "$d" && dc coverage/lcov.info --compare-branch=HEAD --ignore-unstaged --fail-under="$FAIL_UNDER") || fail=1
  done
fi
exit $fail
