#!/usr/bin/env bash
# 变更行覆盖率红线 — pre-push 全量兜底
# 对比远程基线(origin/main|master)...HEAD 的 .py/.ts/.tsx 变更:
#   python: 跑 pytest --cov → diff-cover; node(vitest): 跑 vitest --coverage → diff-cover
# 测试失败/覆盖率 <95% 阻断推送; 无对应基础设施的项目打印提示后放行。
set -u
FAIL_UNDER=95

# 链式执行仓库自有 .git/hooks/pre-push (hooksPath 会旁路它们); 失败则短路退出。
# 必须在任何 stdin 消费前执行 — pre-push 的 refs 列表经 stdin 传给 legacy。
legacy="$(git rev-parse --git-dir)/hooks/$(basename "$0")"
if [ -x "$legacy" ]; then
  "$legacy" "$@" || exit $?
fi

REPO=$(git rev-parse --show-toplevel)
cd "$REPO"

COMPARE=""
for b in origin/main origin/master; do
  git rev-parse --verify -q "$b" >/dev/null 2>&1 && { COMPARE="$b"; break; }
done
[ -z "$COMPARE" ] && exit 0  # 无远程基线 (首次推送/纯本地), 跳过

changed=$(git diff --name-only "$COMPARE...HEAD" 2>/dev/null || true)
echo "$changed" | grep -qE '\.py$'       && HAS_PY=1 || HAS_PY=0
echo "$changed" | grep -qE '\.(ts|tsx)$' && HAS_TS=1 || HAS_TS=0
[ $((HAS_PY + HAS_TS)) -eq 0 ] && exit 0

# diff-cover 入口: PATH → 当前 python 环境 → uv 按需拉取; 均无则提示后放行
dc() {
  if command -v diff-cover >/dev/null 2>&1; then diff-cover "$@"
  elif python3 -c 'import diff_cover' >/dev/null 2>&1; then python3 -m diff_cover.diff_cover_tool "$@"
  elif command -v uv >/dev/null 2>&1; then uv tool run diff-cover "$@"
  else echo "[cov-hook] diff-cover 不可用, 跳过 (安装: pip install diff-cover / uv add diff-cover)"; return 0
  fi
}

fail=0

# ---- python: . 或 backend/ 下有 pyproject.toml ----
if [ "$HAS_PY" = 1 ]; then
  for d in . backend; do
    [ -f "$d/pyproject.toml" ] || continue
    (
      cd "$d" || exit 1
      if [ -f uv.lock ] && command -v uv >/dev/null 2>&1; then
        PYCHK=(uv run python -c); PYTEST=(uv run pytest)
      else
        PYCHK=(python3 -c); PYTEST=(python3 -m pytest)
      fi
      if ! "${PYCHK[@]}" 'import pytest, pytest_cov' >/dev/null 2>&1; then
        echo "[cov-hook] $d 缺 pytest/pytest-cov, 跳过 python 覆盖 (uv add --dev pytest pytest-cov 启用)"; exit 0
      fi
      cov_target="."
      [ -d src ] && cov_target="src"
      echo "[cov-hook] ▶ $d: pytest --cov=$cov_target + diff-cover (≥${FAIL_UNDER}%)"
      "${PYTEST[@]}" --cov="$cov_target" --cov-report=xml:coverage.xml -q
      rc=$?
      [ $rc -eq 5 ] && { echo "[cov-hook] $d 无测试, 跳过"; exit 0; }
      [ $rc -ne 0 ] && exit 1
      dc coverage.xml --compare-branch="$COMPARE" --fail-under="$FAIL_UNDER"
    ) || fail=1
  done
fi

# ---- node: . 或 frontend/ 下 package.json 声明 vitest ----
if [ "$HAS_TS" = 1 ]; then
  for d in . frontend; do
    [ -f "$d/package.json" ] || continue
    grep -q '"vitest"' "$d/package.json" || continue
    (
      cd "$d" || exit 1
      echo "[cov-hook] ▶ $d: vitest run --coverage + diff-cover (≥${FAIL_UNDER}%)"
      npx vitest run --coverage || exit 1
      [ -f coverage/lcov.info ] || {
        echo "[cov-hook] $d 未见 coverage/lcov.info (需 @vitest/coverage-v8), 跳过 diff-cover"; exit 0; }
      dc coverage/lcov.info --compare-branch="$COMPARE" --fail-under="$FAIL_UNDER"
    ) || fail=1
  done
fi

[ $fail -ne 0 ] && echo "✗ [cov-hook] 变更行覆盖率红线未通过 (≥${FAIL_UNDER}%); 紧急绕过: git push --no-verify"
exit $fail
