{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-rules/skills/doc-gen/schemas/domain.schema.json",
  "title": "doc-manifest/domains/{domain}.json 契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "layers"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "modulePrefix": { "type": "string" },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "start":          { "$ref": "common.schema.json#/$defs/layer" },
        "adapter":        { "$ref": "common.schema.json#/$defs/layer" },
        "client":         { "$ref": "common.schema.json#/$defs/layer" },
        "application":    { "$ref": "common.schema.json#/$defs/layer" },
        "domain":         { "$ref": "common.schema.json#/$defs/layer" },
        "infrastructure": { "$ref": "common.schema.json#/$defs/layer" }
      }
    }
  }
}
