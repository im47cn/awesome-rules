{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-rules/skills/doc-gen/schemas/articles.schema.json",
  "title": "doc-manifest/articles.json 契约（可选分片）",
  "type": "object",
  "additionalProperties": false,
  "required": ["articles"],
  "properties": {
    "total": { "type": "integer", "minimum": 0 },
    "categories": { "type": "object", "description": "类名 → 篇数，自由映射" },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "category": { "type": "string" },
          "wordCount": { "type": "integer", "minimum": 0 },
          "sourcePath": { "type": "string" },
          "link": { "type": "string" },
          "body": { "type": "string" },
          "searchText": { "type": "string" }
        }
      }
    }
  }
}
