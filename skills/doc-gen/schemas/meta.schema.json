{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-rules/skills/doc-gen/schemas/meta.schema.json",
  "title": "doc-manifest/meta.json 契约（含 revision-pinned evidence）",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "properties": {
    "project": { "type": "object" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "dirty"],
      "properties": {
        "repo_url": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$" },
        "generatedAt": { "type": "string" },
        "dirty": { "type": "boolean" }
      }
    }
  }
}
