---
// ChatAgent.astro — Architecture AI Agent 对话组件
// 浮动在右下角的 AI 助手，可回答架构问题
// RAG 知识源: doc-manifest.json + Pagefind 搜索
---

<div class="ai-agent-container" id="ai-agent">
  <!-- 触发按钮 -->
  <button class="ai-agent-trigger" id="ai-trigger" aria-label="打开 AI 架构助手">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z"/>
      <path d="M19 3v2M20 4h-2M5 17v2M6 18H4"/>
    </svg>
  </button>

  <!-- 对话面板 -->
  <div class="ai-agent-panel hidden" id="ai-panel">
    <div class="ai-agent-header">
      <h3>🤖 架构 AI 助手</h3>
      <div class="ai-agent-actions">
        <button class="ai-agent-btn" id="ai-clear" title="清空对话">🗑️</button>
        <button class="ai-agent-btn" id="ai-close" title="关闭">✕</button>
      </div>
    </div>

    <div class="ai-agent-messages" id="ai-messages">
      <div class="ai-message system">
        <p>你好！我是架构 AI 助手。我可以回答关于项目架构、DDD 分层、API 设计和数据库结构的问题。</p>
        <p class="ai-message-hint">试着问我：</p>
        <ul>
          <li>"订单聚合包含哪些实体？"</li>
          <li>"Adapter 层有哪些 Controller？"</li>
          <li>"OrderRepository 在哪些地方被调用？"</li>
          <li>"跨域依赖关系是怎样的？"</li>
        </ul>
      </div>
    </div>

    <div class="ai-agent-input-area">
      <textarea
        id="ai-input"
        placeholder="输入架构问题..."
        rows="2"
        class="ai-agent-input"
      ></textarea>
      <button class="ai-agent-send" id="ai-send" aria-label="发送">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </div>

    <div class="ai-agent-footer">
      <span class="ai-agent-model">基于 doc-manifest 本地知识库</span>
    </div>
  </div>
</div>

<style>
  .ai-agent-container {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1000;
  }

  .ai-agent-trigger {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: none;
    background: var(--sl-color-accent);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .ai-agent-trigger:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 24px rgba(0,0,0,0.2);
  }

  .ai-agent-panel {
    position: absolute;
    bottom: 64px;
    right: 0;
    width: 400px;
    max-width: calc(100vw - 2rem);
    height: 560px;
    max-height: calc(100vh - 8rem);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.12);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ai-agent-panel.hidden {
    display: none;
  }

  .ai-agent-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--sl-color-bg);
  }

  .ai-agent-header h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .ai-agent-actions {
    display: flex;
    gap: 0.25rem;
  }

  .ai-agent-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--sl-color-text);
  }

  .ai-agent-btn:hover {
    background: var(--sl-color-hairline);
  }

  .ai-agent-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ai-message {
    max-width: 90%;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    line-height: 1.5;
    word-break: break-word;
  }

  .ai-message.system {
    background: var(--sl-color-hairline);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }

  .ai-message.user {
    background: var(--sl-color-accent);
    color: white;
    align-self: flex-end;
    border-bottom-right-radius: 4px;
  }

  .ai-message.error {
    background: #fee;
    color: #c00;
    align-self: flex-start;
  }

  .ai-message-hint {
    margin: 0.5rem 0 0.25rem;
    font-weight: 500;
    color: var(--sl-color-text);
  }

  .ai-message ul {
    margin: 0.25rem 0 0;
    padding-left: 1.25rem;
  }

  .ai-message li {
    margin: 0.15rem 0;
  }

  .ai-message pre {
    background: var(--sl-color-bg);
    padding: 0.5rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.8rem;
    margin: 0.5rem 0 0;
  }

  .ai-message code {
    font-size: 0.82rem;
  }

  .ai-agent-input-area {
    padding: 0.75rem;
    border-top: 1px solid var(--sl-color-hairline);
    display: flex;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .ai-agent-input {
    flex: 1;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    font-size: 0.85rem;
    font-family: var(--sl-font);
    resize: none;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    line-height: 1.4;
  }

  .ai-agent-input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 2px rgba(var(--sl-color-accent-rgb, 0 0 0), 0.1);
  }

  .ai-agent-send {
    border: none;
    background: var(--sl-color-accent);
    color: white;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }

  .ai-agent-send:hover {
    opacity: 0.85;
  }

  .ai-agent-send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .ai-agent-footer {
    padding: 0.4rem 1rem;
    text-align: center;
    font-size: 0.7rem;
    color: var(--sl-color-text);
    opacity: 0.5;
    border-top: 1px solid var(--sl-color-hairline);
  }

  /* 响应式 */
  @media (max-width: 480px) {
    .ai-agent-panel {
      width: calc(100vw - 2rem);
      right: -0.5rem;
      height: 480px;
    }
  }
</style>

<script>
  // ── RAG 知识库加载（分片模式：先 index → 按需加载域文件）──
  let knowledgeBase: any = null;
  let domainCache: Map<string, any> = new Map();

  async function loadKnowledge() {
    if (knowledgeBase) return knowledgeBase;

    // 先尝试分片 index.json
    try {
      const idxResp = await fetch('/doc-manifest/index.json');
      if (idxResp.ok) {
        const idx = await idxResp.json();
        knowledgeBase = {
          meta: idx,
          diagrams: {},
          crossDomainDependencies: [],
          database: { tables: [] },
          articles: [],
          domains: (idx.domains || []).map((d: any) => ({
            name: d.name,
            displayName: d.displayName,
            projectId: d._project_id,    // 多项目归属（单项目为 undefined）
            projectName: d._project_name,
            layers: null, // 懒加载
            _loaded: false,
          })),
        };
        // 加载手写深度文档（供 AI 关键词检索）
        try {
          const artResp = await fetch('/doc-manifest/articles.json');
          if (artResp.ok) {
            const artData = await artResp.json();
            knowledgeBase.articles = artData.articles || [];
          }
        } catch { /* ignore */ }
        return knowledgeBase;
      }
    } catch { /* fall through */ }

    // 回退：旧版单文件
    try {
      const resp = await fetch('/doc-manifest.json');
      knowledgeBase = await resp.json();
      return knowledgeBase;
    } catch {
      return null;
    }
  }

  /** 按需加载单个域文件（多项目：优先 projects/{id}/ 路径，回退顶级 domains/ 副本） */
  async function loadDomain(name: string, projectId?: string): Promise<any> {
    const cacheKey = projectId ? `${projectId}/${name}` : name;
    if (domainCache.has(cacheKey)) return domainCache.get(cacheKey);
    const paths = projectId
      ? [`/doc-manifest/projects/${projectId}/${name}.json`, `/doc-manifest/domains/${name}.json`]
      : [`/doc-manifest/domains/${name}.json`];
    for (const p of paths) {
      try {
        const resp = await fetch(p);
        if (resp.ok) {
          const data = await resp.json();
          domainCache.set(cacheKey, data);
          return data;
        }
      } catch { /* try next */ }
    }
    return null;
  }

  /** 加载全部分片数据（用于搜索之前预加载，携带项目归属） */
  async function preloadAllDomains(kb: any): Promise<void> {
    if (!kb || !kb.domains) return;
    const toLoad = kb.domains
      .map((d: any) => ({ name: d.name, projectId: d.projectId }))
      .filter((d: any) => !domainCache.has(d.projectId ? `${d.projectId}/${d.name}` : d.name));
    if (toLoad.length === 0) return;
    await Promise.all(toLoad.map((d: any) => loadDomain(d.name, d.projectId)));
  }

  // ── 简单 RAG 检索（分片模式：无 .layers 时从 domainCache 查找）──
  function searchKnowledge(query: string, kb: any): any[] {
    const results: any[] = [];
    const queryLower = query.toLowerCase();
    const keywords = queryLower.split(/\s+/).filter(k => k.length > 1);

    if (!kb || !kb.domains) return results;

    for (const domain of kb.domains) {
      // 分片模式：元数据只有 lean 信息，从缓存获取完整 layers（按项目隔离缓存键）
      const cacheKey = domain.projectId ? `${domain.projectId}/${domain.name}` : domain.name;
      const domainData = domain.layers ? domain : (domainCache.get(cacheKey) || domain);
      const layers = domainData.layers || {};
      // 项目感知的域标签：多项目时附带项目名，避免同名域混淆
      const domainLabel = domain.projectName
        ? `${domain.displayName || domain.name} · ${domain.projectName}`
        : (domain.displayName || domain.name);

      for (const [layerName, layer] of Object.entries<any>(layers)) {
        if (!layer.components) continue;

        for (const comp of layer.components) {
          const searchText = [
            comp.className,
            comp.qualifiedName,
            comp.type,
            comp.description,
            layerName,
            domain.name,
            domain.displayName,
          ].filter(Boolean).join(' ').toLowerCase();

          // 关键词匹配评分
          let score = 0;
          for (const kw of keywords) {
            if (searchText.includes(kw)) score++;
          }

          if (score > 0) {
            results.push({
              domain: domainLabel,
              layer: layerName,
              type: comp.type,
              className: comp.className,
              qualifiedName: comp.qualifiedName,
              sourcePath: comp.sourcePath,
              methods: comp.methods || [],
              fields: comp.fields || [],
              score,
            });
          }
        }

        // 聚合搜索
        if (layer.aggregates) {
          for (const agg of layer.aggregates) {
            const aggText = [
              agg.name,
              agg.rootEntity?.className,
              agg.rootEntity?.qualifiedName,
            ].filter(Boolean).join(' ').toLowerCase();

            let score = 0;
            for (const kw of keywords) {
              if (aggText.includes(kw)) score++;
            }

            if (score > 0) {
              results.push({
                domain: domainLabel,
                layer: layerName,
                type: 'aggregate',
                className: agg.name,
                rootEntity: agg.rootEntity?.className,
                valueObjects: agg.valueObjects?.map((v: any) => v.className) || [],
                entities: agg.entities?.map((e: any) => e.className) || [],
                domainEvents: agg.domainEvents?.map((e: any) => e.className) || [],
                score,
              });
            }
          }
        }
      }
    }

    // 数据库搜索
    if (kb.database?.tables) {
      for (const table of kb.database.tables) {
        const tableText = [table.name, table.comment].filter(Boolean).join(' ').toLowerCase();
        let score = 0;
        for (const kw of keywords) {
          if (tableText.includes(kw)) score++;
        }
        if (score > 0) {
          results.push({
            domain: 'database',
            layer: 'database',
            type: 'table',
            className: table.name,
            comment: table.comment,
            columns: table.columns,
            score,
          });
        }
      }
    }

    // 深度文档搜索
    if (kb.articles && kb.articles.length > 0) {
      for (const art of kb.articles) {
        const artText = [
          art.title, art.summary, art.searchText, art.category,
        ].filter(Boolean).join(' ').toLowerCase();
        let score = 0;
        for (const kw of keywords) {
          if (artText.includes(kw)) score++;
        }
        if (score > 0) {
          results.push({
            domain: '深度文档',
            layer: art.category,
            type: 'article',
            className: art.title,
            summary: art.summary,
            link: art.link,
            score,
          });
        }
      }
    }

    // 排序并限制
    results.sort((a: any, b: any) => b.score - a.score);
    return results.slice(0, 10);
  }

  // ── 简单问答生成（本地 RAG，无需 LLM API）──
  function generateAnswer(query: string, results: any[]): string {
    if (results.length === 0) {
      return '抱歉，在本地知识库中没有找到与 "' + query + '" 相关的信息。\n\n请尝试：\n- 使用更具体的关键词\n- 询问关于 DDD 分层、聚合、实体、Controller 等问题\n- 查看[架构总览](/architecture)页面获取完整信息';
    }

    let answer = '根据本地知识库检索结果：\n\n';
    const shown = new Set<string>();

    for (const r of results) {
      const key = `${r.domain}/${r.layer}/${r.className}`;
      if (shown.has(key)) continue;
      shown.add(key);

      if (r.type === 'aggregate') {
        answer += `### 📦 ${r.className} 聚合 (${r.domain})\n\n`;
        if (r.rootEntity) {
          answer += `- **聚合根**: \`${r.rootEntity}\`\n`;
        }
        if (r.entities.length > 0) {
          answer += `- **实体**: ${r.entities.map((e: string) => '`' + e + '`').join(', ')}\n`;
        }
        if (r.valueObjects.length > 0) {
          answer += `- **值对象**: ${r.valueObjects.map((v: string) => '`' + v + '`').join(', ')}\n`;
        }
        if (r.domainEvents.length > 0) {
          answer += `- **领域事件**: ${r.domainEvents.map((e: string) => '`' + e + '`').join(', ')}\n`;
        }
        answer += '\n';
      } else if (r.type === 'table') {
        answer += `### 🗄️ ${r.className}\n\n`;
        if (r.comment) answer += `> ${r.comment}\n\n`;
        if (r.columns) {
          answer += '| 字段 | 类型 | 主键 | 说明 |\n|------|------|------|------|\n';
          for (const col of r.columns.slice(0, 10)) {
            const pk = col.primaryKey ? '✅' : '';
            answer += `| \`${col.name}\` | ${col.type} | ${pk} | ${col.comment || ''} |\n`;
          }
        }
        answer += '\n';
      } else if (r.type === 'article') {
        answer += `### 📄 [${r.className}](${r.link})\n\n`;
        answer += `- **分类**: ${r.layer}\n`;
        if (r.summary) answer += `\n> ${r.summary}\n\n`;
        answer += `\n→ [查看完整文档](${r.link})\n\n`;
      } else {
        answer += `### \`${r.className}\`\n\n`;
        answer += `- **类型**: ${r.type}\n`;
        answer += `- **所属域**: ${r.domain}\n`;
        answer += `- **分层**: ${r.layer}\n`;
        answer += `- **完整限定名**: \`${r.qualifiedName}\`\n`;
        if (r.sourcePath) answer += `- **源代码**: \`${r.sourcePath}\`\n`;
        if (r.methods.length > 0) {
          answer += `- **方法**: ${r.methods.map((m: string) => '`' + m + '()`').join(', ')}\n`;
        }
        if (r.fields.length > 0) {
          answer += `- **字段**: ${r.fields.map((f: any) => '`' + f.name + ': ' + f.type + '`').join(', ')}\n`;
        }
        answer += '\n';
      }
    }

    answer += '---\n';
    answer += `> 💡 这是基于本地知识库 (\`doc-manifest/\` 分片) 的 RAG 检索结果。`;
    if (results.length >= 10) {
      answer += ' 结果可能被截断，请尝试更精确的查询。';
    }
    return answer;
  }

  // ── UI 控制 ──
  function initAgent() {
    const trigger = document.getElementById('ai-trigger')!;
    const panel = document.getElementById('ai-panel')!;
    const closeBtn = document.getElementById('ai-close')!;
    const clearBtn = document.getElementById('ai-clear')!;
    const sendBtn = document.getElementById('ai-send')!;
    const input = document.getElementById('ai-input') as HTMLTextAreaElement;
    const messages = document.getElementById('ai-messages')!;

    // 元素缺失时跳过绑定，避免后续 DOM 操作的空引用
    if (!trigger || !panel || !messages || !sendBtn || !input || !closeBtn || !clearBtn) return;

    if (!trigger || !panel || !closeBtn || !sendBtn || !input || !messages) return;

    // 切换面板
    trigger.addEventListener('click', () => {
      panel.classList.toggle('hidden');
      if (!panel.classList.contains('hidden')) {
        input.focus();
      }
    });

    closeBtn.addEventListener('click', () => {
      panel.classList.add('hidden');
    });

    clearBtn.addEventListener('click', () => {
      messages.innerHTML = `
        <div class="ai-message system">
          <p>对话已清空。有什么可以帮助你的？</p>
        </div>
      `;
    });

    // 发送消息
    async function sendMessage() {
      const text = input.value.trim();
      if (!text) return;

      // 添加用户消息
      const userMsg = document.createElement('div');
      userMsg.className = 'ai-message user';
      userMsg.textContent = text;
      messages.appendChild(userMsg);
      input.value = '';
      sendBtn.setAttribute('disabled', 'true');

      // 加载知识库 + 预加载所有域文件（分片模式）
      const kb = await loadKnowledge();
      if (kb && kb.domains) {
        await preloadAllDomains(kb);
      }

      // 添加加载指示
      const loadingMsg = document.createElement('div');
      loadingMsg.className = 'ai-message system';
      loadingMsg.textContent = '检索中...';
      messages.appendChild(loadingMsg);
      messages.scrollTop = messages.scrollHeight;

      // RAG 检索 + 生成
      let answer: string;
      try {
        const results = searchKnowledge(text, kb);
        answer = generateAnswer(text, results);
      } catch (e) {
        answer = '检索过程中发生错误: ' + (e instanceof Error ? e.message : String(e));
      }

      // 替换加载指示
      loadingMsg.innerHTML = answer.split('\n').map(line => {
        if (line.startsWith('### ')) return `<h4>${line.slice(4)}</h4>`;
        if (line.startsWith('- ')) return `<li>${line.slice(2)}</li>`;
        if (line.startsWith('> ')) return `<blockquote>${line.slice(2)}</blockquote>`;
        if (line.startsWith('| ')) return `<p><code>${line}</code></p>`;
        if (line === '---') return '<hr/>';
        return `<p>${line}</p>`;
      }).join('');

      messages.scrollTop = messages.scrollHeight;
      sendBtn.removeAttribute('disabled');
      input.focus();
    }

    sendBtn.addEventListener('click', sendMessage);
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
  }

  // 初始化
  document.addEventListener('DOMContentLoaded', initAgent);
</script>
