---
// ArchitectureDiagram.astro — 可交互的 Mermaid 架构图
// 从 doc-manifest/diagrams.json (分片) 或 doc-manifest.json (旧版) 加载
import fs from 'node:fs';
import path from 'node:path';

let diagram = `graph TD
  A[Adapter 接口层] --> B[Application 应用层]
  B --> C[Domain 领域层]
  D[Infrastructure 基础设施层] --> C
  B --> D`;

try {
  // 分片优先
  const diagramsFile = path.resolve('doc-manifest/diagrams.json');
  if (fs.existsSync(diagramsFile)) {
    const data = JSON.parse(fs.readFileSync(diagramsFile, 'utf-8'));
    diagram = data.architectureOverview || diagram;
  } else {
    // 旧版单文件
    const raw = fs.readFileSync('doc-manifest.json', 'utf-8');
    const manifest = JSON.parse(raw);
    diagram = manifest?.diagrams?.architectureOverview || diagram;
  }
} catch {
  // manifest not available — use default diagram
}
---

<div class="architecture-diagram-container">
  <div class="mermaid-wrapper">
    <pre class="mermaid" data-zoom="true">
{diagram}
    </pre>
  </div>

  <!-- 图例 -->
  <div class="diagram-legend">
    <span class="legend-item"><span class="legend-icon">🖥️</span> Adapter 接口层</span>
    <span class="legend-item"><span class="legend-icon">⚙️</span> Application 应用层</span>
    <span class="legend-item"><span class="legend-icon">🧠</span> Domain 领域层</span>
    <span class="legend-item"><span class="legend-icon">🏗️</span> Infrastructure 基础设施层</span>
    <span class="legend-item"><span class="legend-icon">📦</span> Client 契约层</span>
  </div>
</div>

<style>
  .architecture-diagram-container {
    margin: 1.5rem 0;
  }
  .mermaid-wrapper {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
  }
  .diagram-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--sl-color-text);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .legend-icon {
    font-size: 1rem;
  }
</style>
