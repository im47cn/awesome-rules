<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.OrderMapper">

    <sql id="baseColumns">
        id, order_no, order_status, buyer_name, create_time
    </sql>

    <!-- 违规: SELECT * -->
    <select id="selectAll" resultType="Order">
        SELECT * FROM t_order WHERE 1=1
    </select>

    <!-- 合规: 指定字段 + WHERE -->
    <select id="selectById" resultType="Order">
        SELECT id, order_no, order_status
        FROM t_order
        WHERE id = #{id}
    </select>

    <!-- 违规: count(字段) -->
    <select id="countOrders" resultType="int">
        SELECT count(order_no) FROM t_order WHERE del_flag = 0
    </select>

    <!-- 违规: 多表关联但字段无前缀 -->
    <select id="selectWithJoin" resultType="map">
        SELECT id, order_no, name
        FROM t_order o
        INNER JOIN t_buyer b ON o.buyer_id = b.id
        WHERE o.del_flag = 0
    </select>

    <!-- 违规: RIGHT JOIN + 无意义别名 + 左模糊 -->
    <select id="selectComplex" resultType="map">
        SELECT t1.id, a.name
        FROM t_order t1
        RIGHT JOIN t_buyer a ON t1.buyer_id = a.id
        WHERE a.name LIKE '%张三%'
    </select>

    <!-- 违规: 简写 JOIN -->
    <select id="selectJoin" resultType="map">
        SELECT o.id, b.name
        FROM t_order o
        JOIN t_buyer b ON o.buyer_id = b.id
        WHERE o.del_flag = 0
    </select>

    <!-- 违规: INSERT 未列字段 -->
    <insert id="insertBad">
        INSERT INTO t_order VALUES (#{id}, #{orderNo}, #{status})
    </insert>

    <!-- 合规: INSERT 列出字段 -->
    <insert id="insertGood">
        INSERT INTO t_order (id, order_no, order_status)
        VALUES (#{id}, #{orderNo}, #{status})
    </insert>

    <!-- 违规: UPDATE 无 WHERE -->
    <update id="updateAllBad">
        UPDATE t_order SET order_status = 1
    </update>

    <!-- 违规: DELETE 无 WHERE -->
    <delete id="deleteAllBad">
        DELETE FROM t_order
    </delete>

    <!-- 违规: DDL in mapper -->
    <update id="dangerousAlter">
        ALTER TABLE t_order ADD COLUMN extra varchar(50)
    </update>

    <!-- 违规: WHERE 函数转换 -->
    <select id="selectByDate" resultType="Order">
        SELECT id, order_no FROM t_order
        WHERE DATE_FORMAT(create_time, '%Y%m') = '202401'
    </select>

    <!-- 合规: 动态 SQL with include -->
    <select id="selectByCondition" resultType="Order">
        SELECT <include refid="baseColumns"/>
        FROM t_order
        <where>
            <if test="orderNo != null">
                AND order_no = #{orderNo}
            </if>
            <if test="status != null">
                AND order_status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 合规: foreach -->
    <select id="selectByIds" resultType="Order">
        SELECT id, order_no FROM t_order
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
