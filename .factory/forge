#!/usr/bin/env python3
"""forge — 平台适配层：gh 兼容 argv shim（ADR-007）。

架构（对齐设计文档 §4 引擎适配层思想：与平台的耦合面收敛为单一文件）：
- 调用面：.factory 各脚本继续使用 gh 子命令形状（issue/pr/label/api/auth），
  仅把二进制名换成 forge。state.py 消费的 JSON 形状不变。
- 后端选择：仓库根 .factory/forge.json 的 backend 字段；
  文件缺失/无 codeup 配置 = github 后端 → os.execvp("gh")，零行为变化
  （上游 awesome-rules 不需要 forge.json）。
- codeup 后端：阿里云云效（openapi-rdc.aliyuncs.com，x-yunxiao-token）。
  事实模型映射：
    issue  = projex 工作项（N = serialNumber 如 KFPT-16，或 24-hex id）
    label  = 工作项 labels[]（codeup label create = no-op：标签自由文本无注册表）
    PR     = codeup changeRequest（number = localId）
    PR 侧标签/事件 = MR 全局评论标记（Codeup MR 无 labels/timeline）：
      --add-label X    → 发评论 "[factory:label:add] X"（resolved=false）
      --remove-label X → 将该 X 的标记评论置 resolved（内容保留）
      labels[] = 未 resolved 的 add 标记去重；events = 全部 add 标记
      （resolved 不减计数——与 GitHub label-add 事件计数语义对齐：
       重派前 remove、再打回再 add，轮次单调递增）
    reviewDecision = TO_BE_MERGED→APPROVED；存在人工标记评论
      "[factory:changes-requested]"→CHANGES_REQUESTED；否则 ""。
      （Codeup 无 GitHub reviewDecision 等价物；人工打回手势固化为标记
      评论约定，写在 forge.json 配置说明里。）
  fail-closed：未知子命令/标志 → exit 2（禁止静默忽略）。
"""
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

EXIT_OK, EXIT_FAIL, EXIT_USAGE = 0, 1, 2
API_BASE = "https://openapi-rdc.aliyuncs.com"
# Codeup MR status → gh PR state（state.py 只分支 OPEN/非 OPEN）
MR_OPEN_STATES = {"UNDER_DEV", "UNDER_REVIEW", "TO_BE_MERGED"}
# 工作项逻辑态：NON_NORMAL 一律视为 CLOSED（终态清理语义交给 state.py）
LABEL_ADD_MARK = "[factory:label:add]"
CHANGES_REQ_MARK = "[factory:changes-requested]"
# issue 侧标签的描述标记载体（ADR-007）：云效 Task 类型可无 labels 字段
# （字段配置面），描述尾部 HTML 注释块承载——实测云效富文本完整保留注释
LABELS_MARK_RE = re.compile(r"<!--\s*factory:labels:v1:\s*(.*?)\s*-->")


def _desc_labels(raw):
    """描述原文 → 标签列表（无块=空）。"""
    m = LABELS_MARK_RE.search(raw or "")
    return m.group(1).split() if m and m.group(1) else []


def _desc_set_labels(raw, labels):
    """描述原文 + 目标标签 → 新描述（旧块剥离，尾部追加；空标签=移除块）。"""
    base = LABELS_MARK_RE.sub("", raw or "").rstrip()
    if not labels:
        return base
    return base + "\n\n<!-- factory:labels:v1: " + " ".join(sorted(labels)) + " -->"


def die(msg, code=EXIT_FAIL):
    print(f"forge: {msg}", file=sys.stderr)
    sys.exit(code)


# ── 配置 ──────────────────────────────────────────────────────────────

def load_cfg(repo_root):
    """forge.json 缺失 → github 后端（上游形态，零配置）。"""
    path = os.path.join(repo_root, ".factory", "forge.json")
    if not os.path.isfile(path):
        return {"backend": "github"}
    try:
        cfg = json.load(open(path))
    except (OSError, ValueError) as e:
        die(f"forge.json 损坏（fail-closed）: {e}", EXIT_USAGE)
    if cfg.get("backend") == "codeup":
        c = cfg.get("codeup") or {}
        missing = [k for k in ("org_id", "repo_id", "space_id", "workitem_type_id")
                   if not c.get(k)]
        if missing:
            die(f"forge.json codeup 配置缺键: {missing}（fail-closed）", EXIT_USAGE)
    return cfg


def find_repo_root():
    """从 cwd 向上找 .git；找不到则用 cwd（ forge 也可能被无仓环境调用做探测）。"""
    d = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return os.getcwd()
        d = parent


# ── github 后端：透传 exec（零行为变化）────────────────────────────────

def run_github(argv):
    try:
        os.execvp("gh", ["gh", *argv])
    except FileNotFoundError:
        die("github 后端需要 gh CLI（PATH 未找到）", EXIT_USAGE)


# ── codeup REST 客户端 ─────────────────────────────────────────────────

class Codeup:
    def __init__(self, cfg):
        self.cfg = cfg
        self.org = str(cfg["org_id"])
        self.repo = str(cfg["repo_id"])
        self.space = str(cfg["space_id"])
        self.wit = str(cfg["workitem_type_id"])
        # 目标分支：pr create 无 --base（gh 从默认分支推导；codeup 用配置）
        self.base_branch = str(cfg.get("base_branch") or "master")
        # issue 标签载体：native=工作项 labels 字段（类型已配置时）；
        # description=描述尾部标记块（字段缺失时的等价载体）
        self.issue_labels = str(cfg.get("issue_labels") or "native")
        tok = os.environ.get("YUNXIAO_ACCESS_TOKEN")
        if not tok:
            die("codeup 后端需要 YUNXIAO_ACCESS_TOKEN 环境变量", EXIT_USAGE)
        self.tok = tok

    def call(self, path, method="GET", body=None, query=None):
        url = API_BASE + path
        if query:
            url += "?" + urllib.parse.urlencode(query)
        data = None
        headers = {"x-yunxiao-token": self.tok}
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        # 握手级瞬断重试：公司网关对快速连续 TLS 握手会 RST（SSLEOFError，
        # 2026-08-25 实测）。握手失败=请求未发出，对所有方法重试皆安全
        # （非幂等 POST 不会重复执行）。
        import time as _time
        last_exc = None
        for attempt in range(3):
            req = urllib.request.Request(url, headers=headers, data=data, method=method)
            try:
                with urllib.request.urlopen(req, timeout=30) as r:
                    payload = r.read()
                    return json.loads(payload) if payload else {}
            except urllib.error.HTTPError as e:
                detail = e.read()[:200].decode(errors="replace")
                die(f"codeup API {method} {path} → HTTP {e.code}: {detail}")
            except (urllib.error.URLError, TimeoutError) as e:
                last_exc = e
                _time.sleep(1.5 * (attempt + 1))
        die(f"codeup API 不可达（fail-closed，不降级；含握手重试 3 次）: {last_exc}")

    # ── 工作项（issue 侧）──
    def p_workitems(self):
        return f"/oapi/v1/projex/organizations/{self.org}/workitems"

    def wi_get(self, n):
        return self.call(f"{self.p_workitems()}/{urllib.parse.quote(str(n), safe='')}")

    def wi_search(self, per_page=100):
        """全量工厂 issue 候选：按类型拉取（labels 过滤在 forge 侧做）。"""
        out, page = [], 1
        while True:
            # search 契约：category 必填（workitemTypeId 过滤会被拒——
            # 「工作项类型不能为空」实测 2026-08-25）；工厂 issue 池 = 该
            # space 的 Task 类，wit（类型 id）仅用于 issue create
            r = self.call(f"{self.p_workitems()}:search", "POST",
                          {"spaceId": self.space, "category": "Task",
                           "perPage": per_page, "page": page,
                           "orderBy": "gmtCreate", "sort": "desc"})
            batch = r.get("result") if isinstance(r, dict) else r
            if not batch:
                return out
            out.extend(batch)
            if len(batch) < per_page:
                return out
            page += 1

    def wi_comments(self, wid):
        return self.call(f"{self.p_workitems()}/{urllib.parse.quote(str(wid), safe='')}/comments")

    def wi_set_labels(self, wi, labels):
        """native：直写 labels 字段；description：描述块重写（读-改-写，
        单字段 PUT 不触碰 subject/status 等其余字段）。"""
        labels = sorted(set(labels))
        if self.issue_labels == "description":
            new_desc = _desc_set_labels(wi.get("description") or "", labels)
            return self.call(
                f"{self.p_workitems()}/{urllib.parse.quote(str(wi['id']), safe='')}",
                "PUT", {"description": new_desc,
                        "formatType": wi.get("formatType") or "MARKDOWN"})
        return self.call(
            f"{self.p_workitems()}/{urllib.parse.quote(str(wi['id']), safe='')}",
            "PUT", {"labels": labels})

    # ── 合并请求（PR 侧）──
    def p_mrs(self):
        return f"/oapi/v1/codeup/organizations/{self.org}/repositories/{self.repo}/changeRequests"

    def mr_get(self, local_id):
        return self.call(f"{self.p_mrs()}/{local_id}")

    def mr_list(self, state=None):
        out, page = [], 1
        while True:
            # 实测契约（2026-08-25）：list 是组织级端点（无 /repositories 段），
            # GET + URL query 过滤 projectIds（POST/body 形态均被拒）。
            # 摘要行无 status 字段——开合过滤交给服务端 state 参数
            q = {"page": page, "perPage": 100, "projectIds": self.repo}
            if state and state != "all":
                q["state"] = {"open": "opened"}.get(state, state)
            r = self.call(f"/oapi/v1/codeup/organizations/{self.org}/changeRequests",
                          "GET", query=q)
            batch = r.get("result") if isinstance(r, dict) else r
            if not batch:
                return out
            out.extend(batch)
            if len(batch) < 100:
                return out
            page += 1

    def mr_comments(self, local_id):
        """全部全局评论（resolved 与否都取：标记事实不可丢）。"""
        out = []
        for resolved in (False, True):
            r = self.call(f"{self.p_mrs()}/{local_id}/comments/list", "POST",
                          {"patchSetBizIds": [], "commentType": "GLOBAL_COMMENT",
                           "state": "OPENED", "resolved": resolved})
            out.extend(r if isinstance(r, list) else [])
        return out

    def mr_comment_create(self, local_id, content, resolved=True):
        """resolved 语义：普通评论 True（无标记语义）；标签标记评论必须
        False——marker_labels 只认未 resolved 的 add 标记为活跃标签。"""
        return self.call(f"{self.p_mrs()}/{local_id}/comments", "POST",
                         {"content": content, "comment_type": "GLOBAL_COMMENT",
                          "resolved": resolved})

    def mr_comment_resolve(self, local_id, biz_id, resolved):
        return self.call(f"{self.p_mrs()}/{local_id}/comments/{biz_id}", "PUT",
                         {"resolved": resolved})


# ── 形状映射：codeup 原始 → gh JSON ────────────────────────────────────

def html_to_text(s):
    if not s:
        return ""
    # description 可能是 {"htmlValue": "..."} JSON 字符串
    if s.lstrip().startswith("{"):
        try:
            s = json.loads(s).get("htmlValue") or ""
        except ValueError:
            pass
    s = re.sub(r"<[^>]+>", " ", s)
    return re.sub(r"[ \t]+", " ", s).strip()


def wi_state(wi):
    ls = (wi.get("logicalStatus") or "NORMAL").upper()
    return "CLOSED" if ls != "NORMAL" else "OPEN"


def wi_labels(wi, mode="native"):
    if mode == "description":
        names = _desc_labels(wi.get("description"))
    else:
        names = [l for l in (wi.get("labels") or []) if isinstance(l, str)]
    return [{"name": n} for n in names]


def wi_to_issue(wi, cx, want_comments):
    out = {
        "number": wi.get("serialNumber") or wi.get("id"),
        "state": wi_state(wi),
        "labels": wi_labels(wi, cx.issue_labels if cx else "native"),
        "title": wi.get("subject") or "",
        "body": html_to_text(wi.get("description")),
    }
    if want_comments:
        cs = cx.wi_comments(wi["id"])
        out["comments"] = [{"author": {"login": (c.get("author") or {}).get("name", "")},
                            "body": html_to_text(c.get("content"))}
                           for c in cs]
    return out


def marker_labels(comments):
    """未 resolved 的 add 标记 → labels[]。"""
    names = []
    for c in comments:
        content = html_to_text(c.get("content"))
        if content.startswith(LABEL_ADD_MARK):
            name = content[len(LABEL_ADD_MARK):].strip()
            if name and not c.get("resolved", False):
                if name not in names:
                    names.append(name)
    return names


def review_decision(mr, comments):
    if mr.get("status") == "TO_BE_MERGED":
        return "APPROVED"
    for c in comments:
        if html_to_text(c.get("content")).startswith(CHANGES_REQ_MARK):
            return "CHANGES_REQUESTED"
    return ""


def mr_to_pr(mr, comments, want_body=False):
    out = {
        "number": mr.get("localId"),
        "state": "OPEN" if mr.get("status") in MR_OPEN_STATES else "CLOSED",
        "reviewDecision": review_decision(mr, comments),
        "labels": [{"name": n} for n in marker_labels(comments)],
        "headRefName": mr.get("sourceBranch"),
        "baseRefName": mr.get("targetBranch"),
        "mergeable": "MERGEABLE" if mr.get("conflictCheckStatus") == "NO_CONFLICT"
                     else "CONFLICTING",
    }
    if want_body:
        out["body"] = html_to_text(mr.get("description"))
    return out


def project(obj, fields):
    """gh --json 字段投影；缺字段 → null（gh 兼容）。"""
    return [{f: o.get(f) for f in fields} for o in obj]


# ── argv 解析（通用轻量：已知标志集合，fail-closed）──────────────────────

KNOWN_FLAGS = {
    "--repo", "--json", "--state", "--limit", "--label", "--add-label",
    "--remove-label", "--body", "--body-file", "--title", "--head", "--fill",
    "--color", "--description", "--force", "--paginate", "--jq", "--admin",
    "--merge", "--squash", "--rebase", "--name-only",
}
MERGE_METHODS = {"--merge", "--squash", "--rebase"}


def parse_argv(argv):
    """→ {cmd, sub, pos[], flags{flag:[values]}, json_fields, jq}"""
    if not argv:
        die("用法: forge <issue|pr|label|api|auth> ...", EXIT_USAGE)
    cmd = argv[0]
    rest = argv[1:]
    pos, flags = [], {}
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "-q":  # gh 的 --jq 简写（factory_lib _issue_in_progress 用）
            if i + 1 >= len(rest):
                die("-q 缺表达式", EXIT_USAGE)
            flags.setdefault("--jq", []).append(rest[i + 1])
            i += 2
            continue
        if a.startswith("--"):
            if a in MERGE_METHODS or a in ("--fill", "--force", "--paginate",
                                           "--admin", "--name-only"):
                flags[a] = ["true"]
                i += 1
                continue
            if a not in KNOWN_FLAGS:
                die(f"未知标志 {a}（fail-closed：codeup 后端不静默忽略标志）", EXIT_USAGE)
            if i + 1 >= len(rest):
                die(f"标志 {a} 缺值", EXIT_USAGE)
            flags.setdefault(a, []).append(rest[i + 1])
            i += 2
        else:
            pos.append(a)
            i += 1
    fields = (flags.get("--json") or [""])[0].split(",") if "--json" in flags else None
    jq = (flags.get("--jq") or [None])[0]
    return cmd, pos, flags, fields, jq


def gh_issue(cx, pos, flags, fields):
    sub = pos[0] if pos else die("issue 需要子命令", EXIT_USAGE)
    if sub == "view":
        n = pos[1]
        wi = cx.wi_get(n)
        want_comments = not fields or "comments" in fields
        issue = wi_to_issue(wi, cx, want_comments)
        out = {f: issue.get(f) for f in fields} if fields else issue
        if "--jq" in flags:
            print("\n".join(_apply_jq(flags["--jq"][0], out)))
        else:
            print(json.dumps(out, ensure_ascii=False))
        return EXIT_OK
    if sub == "list":
        state = (flags.get("--state") or ["open"])[0]
        if state not in ("open", "all"):
            die(f"issue list --state 仅支持 open/all（得到 {state}）", EXIT_USAGE)
        wis = cx.wi_search()
        issues = []
        for wi in wis:
            if state != "all" and wi_state(wi) != "OPEN":
                continue
            issue = wi_to_issue(wi, cx, "comments" in (fields or []))
            if "--label" in flags:
                names = {l["name"] for l in issue["labels"]}
                if not all(l in names for l in flags["--label"]):
                    continue
            issues.append(issue)
        lim = int((flags.get("--limit") or ["100"])[0])
        print(json.dumps(project(issues[:lim], fields or ["number", "labels"]),
                         ensure_ascii=False))
        return EXIT_OK
    if sub == "edit":
        n = pos[1]
        wi = cx.wi_get(n)
        labels = [l["name"] for l in wi_labels(wi, cx.issue_labels)]
        for x in flags.get("--add-label", []):
            if x not in labels:
                labels.append(x)
        for x in flags.get("--remove-label", []):
            labels = [l for l in labels if l != x]
        cx.wi_set_labels(wi, labels)
        return EXIT_OK
    if sub == "comment":
        n = pos[1]
        wi = cx.wi_get(n)
        if "--body-file" in flags:
            body = open(flags["--body-file"][0]).read()
        else:
            body = (flags.get("--body") or [""])[0]
        cx.call(f"{cx.p_workitems()}/{urllib.parse.quote(str(wi['id']), safe='')}/comments",
                "POST", {"content": body, "contentType": "markdown"})
        return EXIT_OK
    if sub == "create":
        title = (flags.get("--title") or die("issue create 需要 --title", EXIT_USAGE))[0]
        body = ""
        if "--body-file" in flags:
            body = open(flags["--body-file"][0]).read()
        elif "--body" in flags:
            body = flags["--body"][0]
        # 云效 create 完整解法（2026-08-26 破案，官方 swagger + 实测）：
        # 1. create API 本体必填仅 assignedTo/spaceId/subject/workitemTypeId
        #    （CreateWorkitemRequest）；「计划开始时间」等是模板层
        #    SystemCustomField，须经 customFieldValues {"fieldId":"value"}
        #    平面对象传（数组形态报 Invalid format）。
        # 2. fieldId 从字段配置接口发现：
        #    GET projects/{spaceId}/workitemTypes/{wit}/fields → required
        #    字段的 id（实测 79/80=计划起止、101586=预计工时、priority）。
        # 3. value 形态：date=ISO 日期；float=小数字符串（"0.5"，"1h" 拒）；
        #    list=option **id**（非文本——"低"拒、"c18e89…" 过）。
        # 4. assignedTo=24-hex 用户 id（工作项详情 assignedTo.id 形态；
        #    成员查询端点不可达，取 forge.json codeup.assign_user_id）。
        def _default_cfvs(cx):
            """拉字段配置，为全部 required 的 SystemCustomField 构造默认值。"""
            import datetime as _dt
            today = _dt.date.today().isoformat()
            due = (_dt.date.today() + _dt.timedelta(days=7)).isoformat()
            fields = cx.call(
                f"/oapi/v1/projex/organizations/{cx.org}/projects/{cx.space}"
                f"/workitemTypes/{cx.wit}/fields")
            out = {}
            for f in (fields if isinstance(fields, list) else fields.get("result", [])):
                if f.get("required") not in (True, "true", 1):
                    continue
                if f.get("type") == "NativeField":
                    continue  # subject/assignedTo 走本体字段
                fid, name, fmt = str(f["id"]), f["name"], f.get("format", "")
                if "开始" in name:
                    out[fid] = today
                elif "完" in name or "结束" in name:
                    out[fid] = due
                elif fmt == "float":
                    out[fid] = "0.5"
                elif fmt == "date":
                    out[fid] = today
                elif f.get("options"):
                    out[fid] = str(f["options"][-1]["id"])  # 末项=最低档
            return out

        assignee = cx.cfg.get("assign_user_id") or die(
            "codeup issue create 需要 forge.json codeup.assign_user_id"
            "（指派人必填；从工作项详情 assignedTo.id 取 24-hex 值）",
            EXIT_USAGE)
        payload = {"spaceId": cx.space, "subject": title,
                   "workitemTypeId": cx.wit, "description": body,
                   "assignedTo": assignee}
        try:
            payload["customFieldValues"] = _default_cfvs(cx)
        except SystemExit:
            raise
        except Exception as e:
            print(f"forge: [warn] 字段配置拉取失败，create 可能因模板必填"
                  f"被拒: {e}", file=sys.stderr)
        if "--label" in flags:
            payload["labels"] = flags["--label"]
        r = cx.call(cx.p_workitems(), "POST", payload)
        print(json.dumps({"number": r.get("serialNumber") or r.get("id"),
                          "url": r.get("detailUrl", "")}, ensure_ascii=False))
        return EXIT_OK
    die(f"issue 子命令不支持: {sub}", EXIT_USAGE)



def gh_pr(cx, pos, flags, fields):
    sub = pos[0] if pos else die("pr 需要子命令", EXIT_USAGE)
    if sub == "view":
        p = pos[1]
        mr = cx.mr_get(p)
        comments = cx.mr_comments(p)
        pr = mr_to_pr(mr, comments, want_body=not fields or "body" in fields)
        out = {f: pr.get(f) for f in fields} if fields else pr
        print(json.dumps(out, ensure_ascii=False))
        return EXIT_OK
    if sub == "list":
        state = (flags.get("--state") or ["open"])[0]
        if state not in ("open", "all"):
            die(f"pr list --state 仅支持 open/all（得到 {state}）", EXIT_USAGE)
        lim = int((flags.get("--limit") or ["100"])[0])
        prs = []
        for mr in cx.mr_list(state):
            if state != "all" and mr.get("status") is not None \
                    and mr.get("status") not in MR_OPEN_STATES:
                continue
            comments = cx.mr_comments(mr["localId"])
            pr = mr_to_pr(mr, comments, want_body=True)
            if "--label" in flags:
                names = {l["name"] for l in pr["labels"]}
                if not all(l in names for l in flags["--label"]):
                    continue
            prs.append(pr)
        prs = prs[:lim]
        if (fields or []) == ["closingIssuesReferences"] or "closingIssuesReferences" in (fields or []):
            for pr in prs:
                m = re.search(r"[Cc]loses #([\w-]+)", pr.get("body") or "")
                pr["closingIssuesReferences"] = [{"number": m.group(1)}] if m else []
        out = project(prs, fields or ["number"]) if fields else prs
        if "--jq" in flags:
            print("\n".join(_apply_jq(flags["--jq"][0], out)))  # gh 行式输出
        else:
            print(json.dumps(out, ensure_ascii=False))
        return EXIT_OK
    if sub == "create":
        head = (flags.get("--head") or die("pr create 需要 --head", EXIT_USAGE))[0]
        # 无 --title 时 --fill：取远端分支最新提交主题（gh 语义近似）
        if "--title" in flags:
            title = flags["--title"][0]
        elif "--fill" in flags:
            title = _branch_subject(head)
        else:
            die("pr create 需要 --title 或 --fill", EXIT_USAGE)
        body = ""
        if "--body-file" in flags:
            body = open(flags["--body-file"][0]).read()
        elif "--body" in flags:
            body = flags["--body"][0]
        mr = cx.call(cx.p_mrs(), "POST", {
            "title": title, "sourceBranch": head,
            "targetBranch": cx.base_branch,
            "sourceProjectId": cx.repo, "targetProjectId": cx.repo,
            "description": body, "createFrom": "WEB"})
        url = cx.mr_get(mr["localId"]).get("detailUrl", "")
        print(url)
        for x in flags.get("--label", []):
            cx.mr_comment_create(mr["localId"], f"{LABEL_ADD_MARK} {x}", resolved=False)
        return EXIT_OK
    if sub == "edit":
        p = pos[1]
        comments = cx.mr_comments(p)
        for x in flags.get("--add-label", []):
            cx.mr_comment_create(p, f"{LABEL_ADD_MARK} {x}", resolved=False)
        for x in flags.get("--remove-label", []):
            for c in comments:
                content = html_to_text(c.get("content"))
                if content == f"{LABEL_ADD_MARK} {x}" and not c.get("resolved", False):
                    cx.mr_comment_resolve(p, c["comment_biz_id"], True)
        return EXIT_OK
    if sub == "comment":
        p = pos[1]
        body = (flags.get("--body") or
                (open(flags["--body-file"][0]).read() if "--body-file" in flags else None)
                or die("pr comment 需要 --body", EXIT_USAGE))
        cx.mr_comment_create(p, body)
        return EXIT_OK
    if sub == "diff":
        p = pos[1]
        mr = cx.mr_get(p)
        # Codeup diffs/patches 不含统一 diff 文本：用本地 git（分支已推送）
        src, tgt = mr["sourceBranch"], mr["targetBranch"]
        cmd = ["git", "diff", f"origin/{tgt}...origin/{src}"]
        if "--name-only" in flags:
            cmd.append("--name-only")
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            die(f"git diff origin/{tgt}...origin/{src} 失败（先 fetch）: {r.stderr}")
        print(r.stdout, end="")
        return EXIT_OK
    if sub == "merge":
        p = pos[1]
        method = next((m.lstrip("-") for m in MERGE_METHODS if m in flags), "merge")
        cx.call(f"{cx.p_mrs()}/{p}/merge", "POST",
                {"mergeType": method.upper(), "removeSourceBranch": False})
        return EXIT_OK
    die(f"pr 子命令不支持: {sub}", EXIT_USAGE)


def _branch_subject(branch):
    r = subprocess.run(["git", "log", f"origin/{branch}", "-1", "--format=%s"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        die(f"--fill 需要本地可见的 origin/{branch}（先 push/fetch）", EXIT_USAGE)
    return r.stdout.strip()


def _apply_jq(expr, data):
    """最小 jq 投影：覆盖 .factory 调用面的两个表达式
    （.[].closingIssuesReferences[].number / .labels[].name），逐行输出。
    其他表达式 fail-closed 拒绝——静默错投影比失败更危险。"""
    expr = expr.strip()
    try:
        if expr == ".[].closingIssuesReferences[].number" and isinstance(data, list):
            return [str(ref["number"]) for row in data
                    for ref in row.get("closingIssuesReferences", [])]
        if expr == ".labels[].name" and isinstance(data, dict):
            return [l["name"] for l in data.get("labels", [])]
    except (TypeError, KeyError):
        pass
    die(f"codeup 后端不支持 --jq 表达式: {expr}", EXIT_USAGE)


def gh_label(cx, pos, flags):
    # codeup 工作项标签是自由文本，无注册表：create 幂等 no-op（gh --force 同义）
    _ = (cx, pos, flags)
    return EXIT_OK


def gh_api(cx, pos, flags):
    # 唯一用法：repos/{slug}/issues/{P}/events（PR 侧 label-add 计数）
    m = re.match(r"repos/[^/]+/[^/]+/issues/(\d+)/events$", pos[0] if pos else "")
    if not m:
        die(f"codeup 后端不支持 api 路径: {pos and pos[0]}", EXIT_USAGE)
    p = m.group(1)
    events = []
    for c in cx.mr_comments(p):
        content = html_to_text(c.get("content"))
        if content.startswith(LABEL_ADD_MARK):
            name = content[len(LABEL_ADD_MARK):].strip()
            # resolved 不删事件：轮次计数与 GitHub label-add 事件对齐（单调）
            events.append({"event": "labeled", "label": {"name": name}})
    print(json.dumps(events, ensure_ascii=False))


def gh_auth():
    tok = os.environ.get("YUNXIAO_ACCESS_TOKEN")
    if not tok:
        die("codeup 后端未认证（YUNXIAO_ACCESS_TOKEN 未设）")
    cx = Codeup({"org_id": "", "repo_id": "", "space_id": "",
                 "workitem_type_id": ""})
    cx.tok = tok
    cx.call("/oapi/v1/platform/user")
    print("✓ Logged in to codeup (YUNXIAO_ACCESS_TOKEN)")
    return EXIT_OK


# ── 入口 ──────────────────────────────────────────────────────────────

def main():
    argv = sys.argv[1:]
    cfg = load_cfg(find_repo_root())
    # probe 先于 github 分派：两侧都要本地回答后端身份（不透传 gh）
    if argv and argv[0] == "probe":
        backend = cfg.get("backend", "github")
        if backend == "codeup":
            Codeup(cfg["codeup"])  # 配置/令牌存在性校验（fail-closed）
        print(backend)
        return EXIT_OK
    if cfg.get("backend") != "codeup":
        run_github(argv)  # exec，不返回
    cx = Codeup(cfg["codeup"])
    cmd, pos, flags, fields, jq = parse_argv(argv)
    _ = jq
    if cmd == "issue":
        return gh_issue(cx, pos, flags, fields)
    if cmd == "pr":
        return gh_pr(cx, pos, flags, fields)
    if cmd == "label":
        return gh_label(cx, pos, flags)
    if cmd == "api":
        return gh_api(cx, pos, flags)
    if cmd == "auth":
        return gh_auth()
    die(f"codeup 后端不支持命令: {cmd}", EXIT_USAGE)


if __name__ == "__main__":
    sys.exit(main())
